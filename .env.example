# HeyNYC configuration — copy to .env and fill in. NEVER commit .env.

# LLM (litellm model id). Override per your provider.
HEYNYC_MODEL=anthropic/claude-sonnet-4-6
ANTHROPIC_API_KEY=

# NYC Open Data (Socrata) — free app token: https://api-portal.nyc.gov/
# Optional but lifts rate limit from ~throttled to 1000 req/hr.
SOCRATA_APP_TOKEN=

# Forgiving fallback geocoder for intersections / POIs / fuzzy queries that NYC
# GeoSearch can't handle. Free tier covers a demo. https://account.mapbox.com/
MAPBOX_TOKEN=

# Scoped web search provider (Tavily supports include_domains). Optional until Phase 4.
TAVILY_API_KEY=

# Ticketmaster Discovery API — the events module's structured backbone (free).
# https://developer.ticketmaster.com/ . Without it, events fall back to NYC Parks + web_search.
TICKETMASTER_API_KEY=

# Self-hosted OSRM (optional). Defaults to the public demo server.
HEYNYC_OSRM_BASE=https://router.project-osrm.org

# Where cached datasets + the vector index live.
HEYNYC_DATA_DIR=

# Optional application-form draft workflow. Leave blank to keep forms off.
HEYNYC_FORMS=
HEYNYC_PII_KEY=
HEYNYC_PII_RETENTION_DAYS=

# --- Messaging on-ramp (channels) ---
HEYNYC_PII_SALT=                 # required to serve: `openssl rand -hex 32`
WHATSAPP_PROVIDER=meta           # meta | twilio | both
# Meta WhatsApp Cloud API
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=           # you invent this; paste the same value into the Meta dashboard
# Twilio (sandbox / SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# --- NYC Benefits Screening API (Module B) ---
SCREENING_ENV=sandbox            # sandbox | prod
SCREENING_SANDBOX_USERNAME=      # do the one-time /authToken newPassword change first
SCREENING_SANDBOX_PASSWORD=
SCREENING_PROD_USERNAME=
SCREENING_PROD_PASSWORD=
