# HeyNYC configuration: copy to .env and fill in. NEVER commit .env.

# LLM (any litellm model id) and the matching provider key.
HEYNYC_MODEL=openai/gpt-5.4-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# NYC Open Data (Socrata) free app token: https://api-portal.nyc.gov/
# Optional but lifts rate limit from ~throttled to 1000 req/hr.
SOCRATA_APP_TOKEN=

# Forgiving fallback geocoder for intersections / POIs / fuzzy queries that NYC
# GeoSearch can't handle. Free tier covers a demo. https://account.mapbox.com/
MAPBOX_TOKEN=

# Scoped web search provider (Tavily supports include_domains). Optional until Phase 4.
TAVILY_API_KEY=
# Secondary search provider when Tavily is unavailable: https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=
# Event A/B policy for owner-approved live evals: fast | deep. Resident default is fast.
HEYNYC_EVENT_RETRIEVAL_POLICY=fast

# Ticketmaster Discovery API, the events module's structured backbone (free).
# https://developer.ticketmaster.com/ . Without it, events fall back to NYC Parks + web_search.
TICKETMASTER_API_KEY=

# Self-hosted OSRM (optional). Defaults to the public demo server.
HEYNYC_OSRM_BASE=https://router.project-osrm.org

# Where cached datasets + the vector index live.
HEYNYC_DATA_DIR=

# Corresponding source offered to network users. Set this to your modified source repository.
HEYNYC_SOURCE_URL=https://github.com/shayantist/HeyNYC

# Optional application-form draft workflow. Leave blank to keep forms off.
HEYNYC_FORMS=

# Required when serving SMS or WhatsApp because conversation context is persisted.
# Generate with: uv run python -c "from heynyc.core.pii_crypto import generate_key; print(generate_key())"
HEYNYC_PII_KEY=
HEYNYC_PII_RETENTION_DAYS=30

# --- Messaging on-ramp (channels) ---
HEYNYC_PII_SALT=                 # required to serve: `openssl rand -hex 32`
WHATSAPP_PROVIDER=meta           # meta | twilio | both
# Meta WhatsApp Cloud API
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=           # you invent this; paste the same value into the Meta dashboard
# Twilio (sandbox / SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
HEYNYC_NGROK_DOMAIN=             # required by scripts/serve_demo.sh: your reserved ngrok domain
HEYNYC_HEALTH_WATCH_INTERVAL_S=3600   # public health-check cadence for scripts/health_watch.sh (quota: each check spends one tunnel request)
HEYNYC_USER_DAILY_SPEND_CAP=     # optional, e.g. 0.50: per-resident daily model spend cap (USD)

# --- NYC Benefits Screening API (Module B) ---
SCREENING_ENV=sandbox            # sandbox | prod
SCREENING_SANDBOX_USERNAME=      # do the one-time /authToken newPassword change first
SCREENING_SANDBOX_PASSWORD=
SCREENING_PROD_USERNAME=
SCREENING_PROD_PASSWORD=
